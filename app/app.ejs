<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" http-equiv="Content-Security-Policy" content="default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: file: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; img-src 'self' data: blob: https:; connect-src 'self' https:;"/>
    <title><%= lang('app.title') %></title>
    <script src="./assets/js/scripts/uicore.js"></script>
    <script src="./assets/js/scripts/uibinder.js"></script>
    <link type="text/css" rel="stylesheet" href="./assets/css/launcher.css">
    <link type="text/css" rel="stylesheet" href="./assets/css/relaxzone.css">
    <style>
        body {
            transition: background-image 1s ease;
            background: url('assets/images/relaxzone_banner.jpg') no-repeat center center fixed;
            background-size: cover;
            -webkit-user-select: none;
        }
        #main {
            display: none;
            height: calc(100% - 22px);
            background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0) 100%);
            width: 100%;
            position: absolute;
            z-index: 10;
        }
        #main[overlay] {
            filter: blur(3px) contrast(0.9) brightness(1.0);
        }
    </style>
</head>
<body>
    <%- include('frame') %>
    <div id="main">
        <%- include('welcome') %>
        <%- include('login') %>
        <%- include('waiting') %>
        <%- include('loginOptions') %>
        <%- include('settings') %>
        <%- include('landing') %>
        <%- include('modmarket') %>
    </div>
    <%- include('overlay') %>
    <div id="launcherUpdateOverlay" role="dialog" aria-modal="true" aria-live="polite" aria-hidden="true" style="display: none;">
        <div id="launcherUpdateModal" class="rz_update_modal" data-state="checking">
            <div id="launcherUpdateModalIcon" class="rz_update_modal_icon">↻</div>
            <div id="launcherUpdateModalTitle" class="rz_update_modal_title">正在檢查啟動器更新...</div>
            <div id="launcherUpdateModalDescription" class="rz_update_modal_description">請稍候，正在確認是否有可用的新版本。</div>
            <div id="launcherUpdateProgress" class="rz_update_progress" aria-hidden="true">
                <div id="launcherUpdateProgressBar" class="rz_update_progress_bar"></div>
            </div>
            <div id="launcherUpdateProgressText" class="rz_update_progress_text"></div>
            <button id="launcherUpdateAcknowledge" class="rz_update_acknowledge" type="button" style="display: none;">我知道了</button>
        </div>
    </div>
    <div id="loadingContainer">
        <div id="loadingContent">
            <div id="loadSpinnerContainer">
                <img id="loadCenterImage" src="assets/images/relaxzone_logo.png">
                <img id="loadSpinnerImage" class="rotating" src="assets/images/RelaxZoneLoadingRing.svg">
            </div>
        </div>
    </div>
</body>
</html>
