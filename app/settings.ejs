    <!-- 悠然設定輔助 Script -->
    <script>
        function rzSetResolution(w, h, btn) {
            const wEl = document.getElementById('settingsGameWidth');
            const hEl = document.getElementById('settingsGameHeight');
            if (wEl && hEl) {
                wEl.value = w;
                hEl.value = h;
                wEl.dispatchEvent(new Event('input', { bubbles: true }));
                hEl.dispatchEvent(new Event('input', { bubbles: true }));
                wEl.dispatchEvent(new Event('keyup', { bubbles: true }));
                hEl.dispatchEvent(new Event('keyup', { bubbles: true }));
            }
            document.querySelectorAll('.rz_res_chip').forEach(c => c.classList.remove('rz_chip_active'));
            if (btn) btn.classList.add('rz_chip_active');
        }

        function rzSetRAM(gb, btn) {
            const slider = document.getElementById('settingsMaxRAMRange');
            if (slider && typeof updateRangedSlider === 'function' && typeof calculateRangeSliderMeta === 'function') {
                const meta = calculateRangeSliderMeta(slider);
                const val = Math.min(Math.max(gb, meta.min), meta.max);
                updateRangedSlider(slider, val, ((val - meta.min) / meta.step) * meta.inc);
                if (typeof slider.onchange === 'function') {
                    slider.onchange({ target: slider });
                }
            }
            document.querySelectorAll('.rz_ram_chip').forEach(c => c.classList.remove('rz_chip_active'));
            if (btn) btn.classList.add('rz_chip_active');
        }

        function rzApplyAikarFlags() {
            const jvmInput = document.getElementById('settingsJVMOptsVal');
            if (jvmInput) {
                jvmInput.value = '-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1ReservePercent=20 -XX:G1HeapWastePercent=5 -XX:G1MixedGCCountTarget=4 -XX:InitiatingHeapOccupancyPercent=15 -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1RSetUpdatingPauseTimePercent=5 -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1';
                jvmInput.dispatchEvent(new Event('input', { bubbles: true }));
                jvmInput.dispatchEvent(new Event('keyup', { bubbles: true }));
            }
        }
    </script>
    <script src="./assets/js/scripts/settings.js"></script>
